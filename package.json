{
	"name": "trackboi",
	"version": "0.1.0",
	"type": "module",
	"main": "dist-node/electron/main.cjs",
	"bin": {
		"trackboi": "bin/trackboi"
	},
	"description": "A local-first Kanban desktop app with an MCP server.",
	"author": {
		"name": "BumpCore",
		"email": "noreply@trackboi.local"
	},
	"scripts": {
		"dev": "just dev",
		"check": "just check",
		"test": "just test",
		"test:bench": "just test-bench",
		"test:ui": "just test-ui",
		"test:ui:headed": "just test-ui-headed",
		"build": "just build",
		"dist": "just dist",
		"dist:linux": "just build && bunx electron-builder --linux --publish never",
		"dist:mac": "just build && bunx electron-builder --mac --publish never",
		"dist:win": "just build && bunx electron-builder --win --publish never",
		"start": "just start",
		"mcp": "./bin/trackboi mcp",
		"mcp:inspect": "just mcp-inspect"
	},
	"build": {
		"appId": "dev.trackboi.desktop",
		"productName": "trackboi",
		"artifactName": "${productName}-${version}-${arch}.${ext}",
		"directories": {
			"output": "release",
			"buildResources": "build"
		},
		"files": [
			"dist/**",
			"dist-node/**",
			"bin/**",
			"package.json"
		],
		"extraResources": [
			{
				"from": "build/icon.png",
				"to": "assets/trackboi.png"
			},
			{
				"from": "trackboi.svg",
				"to": "assets/trackboi.svg"
			},
			{
				"from": "bin/trackboi",
				"to": "bin/trackboi"
			}
		],
		"extraMetadata": {
			"main": "dist-node/electron/main.cjs"
		},
		"linux": {
			"category": "Development",
			"maintainer": "BumpCore <noreply@trackboi.local>",
			"executableName": "trackboi",
			"icon": "build/icons",
			"target": [
				"AppImage",
				"rpm",
				"deb"
			]
		},
		"mac": {
			"category": "public.app-category.developer-tools",
			"target": [
				"dmg",
				"zip"
			]
		},
		"win": {
			"target": [
				"nsis",
				"zip"
			]
		},
		"nsis": {
			"oneClick": false,
			"perMachine": false,
			"allowToChangeInstallationDirectory": true
		},
		"rpm": {
			"afterInstall": "build/linux/after-install.sh"
		}
	},
	"dependencies": {
		"@fontsource/cascadia-mono": "^5.2.3",
		"@fontsource/inter": "^5.2.8",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@tailwindcss/vite": "^4.2.2",
		"@vueuse/core": "^14.2.1",
		"@vueuse/integrations": "^14.2.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"commander": "^14.0.3",
		"fuse.js": "^7.3.0",
		"lowlight": "^3.3.0",
		"lucide-vue-next": "^1.0.0",
		"markdown-it": "^14.1.1",
		"reka-ui": "^2.9.6",
		"shiki": "^4.0.2",
		"sortablejs": "^1.15.7",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.2.2",
		"ulid": "^3.0.2",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@playwright/test": "^1.56.1",
		"@types/markdown-it": "^14.1.2",
		"@types/node": "^25.6.0",
		"@types/sortablejs": "^1.15.9",
		"@vitejs/plugin-vue": "^5.2.1",
		"concurrently": "^9.2.1",
		"electron": "^41.2.1",
		"electron-builder": "^26.0.12",
		"esbuild": "^0.28.0",
		"playwright": "^1.56.1",
		"typescript": "^5.7.2",
		"vite": "^6.0.3",
		"vue": "^3.5.13",
		"vue-tsc": "^2.2.0",
		"wait-on": "^9.0.5"
	}
}
