{
	"name": "trackboi",
	"version": "1.0.0",
	"type": "module",
	"description": "A local-first Kanban desktop app with an MCP server.",
	"scripts": {
		"start": "vite build && electrobun dev",
		"dev": "electrobun dev --watch",
		"dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
		"hmr": "vite --port 5173",
		"build": "vite build && electrobun build",
		"build:canary": "vite build && electrobun build --env=canary",
		"tauri": "tauri",
		"tauri:dev": "tauri dev",
		"tauri:build": "tauri build"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.2.2",
		"@tauri-apps/api": "^2.10.1",
		"@tauri-apps/plugin-dialog": "^2.7.0",
		"@tauri-apps/plugin-fs": "^2.5.0",
		"@tauri-apps/plugin-shell": "^2.3.5",
		"@vueuse/core": "^14.2.1",
		"@vueuse/integrations": "^14.2.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"electrobun": "1.16.0",
		"lucide-vue-next": "^1.0.0",
		"reka-ui": "^2.9.6",
		"sortablejs": "^1.15.7",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.2.2"
	},
	"devDependencies": {
		"@tauri-apps/cli": "^2.10.1",
		"@types/bun": "latest",
		"@types/node": "^25.6.0",
		"@types/sortablejs": "^1.15.9",
		"@types/three": "^0.183.1",
		"@vitejs/plugin-vue": "^5.2.1",
		"concurrently": "^9.1.0",
		"typescript": "^5.7.2",
		"vite": "^6.0.3",
		"vue": "^3.5.13",
		"vue-tsc": "^2.2.0"
	}
}
