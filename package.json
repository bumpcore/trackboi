{
	"name": "trackboi",
	"version": "1.0.0",
	"type": "module",
	"main": "dist-node/electron/main.cjs",
	"bin": {
		"trackboi": "bin/trackboi"
	},
	"description": "A local-first Kanban desktop app with an MCP server.",
	"scripts": {
		"dev": "concurrently -k \"bun run dev:ui\" \"bun run dev:electron-main\" \"bun run dev:electron-preload\" \"bun run dev:desktop\"",
		"dev:ui": "vite --host 127.0.0.1",
		"dev:electron-main": "esbuild src/electron/main.ts --bundle --platform=node --format=cjs --outfile=dist-node/electron/main.cjs --external:electron --watch",
		"dev:electron-preload": "esbuild src/electron/preload.ts --bundle --platform=node --format=cjs --outfile=dist-node/electron/preload.cjs --external:electron --watch",
		"dev:desktop": "wait-on http://127.0.0.1:5173 dist-node/electron/main.cjs dist-node/electron/preload.cjs && TRACKBOI_DEV_SERVER_URL=http://127.0.0.1:5173 env -u ELECTRON_RUN_AS_NODE electron dist-node/electron/main.cjs",
		"check": "bun run check:types && bun run check:no-any",
		"check:types": "vue-tsc --noEmit",
		"check:no-any": "node scripts/check-no-any.cjs",
		"build": "bun run build:ui && bun run build:node",
		"build:ui": "vite build",
		"build:node": "bun run build:cli && bun run build:electron",
		"build:cli": "esbuild src/cli/entry.ts --bundle --platform=node --format=cjs --outfile=dist-node/cli/main.cjs",
		"build:electron": "esbuild src/electron/main.ts --bundle --platform=node --format=cjs --outfile=dist-node/electron/main.cjs --external:electron && esbuild src/electron/preload.ts --bundle --platform=node --format=cjs --outfile=dist-node/electron/preload.cjs --external:electron",
		"start": "env -u ELECTRON_RUN_AS_NODE electron dist-node/electron/main.cjs",
		"cli": "./bin/trackboi",
		"mcp": "./bin/trackboi mcp"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@tailwindcss/vite": "^4.2.2",
		"@vueuse/core": "^14.2.1",
		"@vueuse/integrations": "^14.2.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"commander": "^14.0.3",
		"lucide-vue-next": "^1.0.0",
		"reka-ui": "^2.9.6",
		"sortablejs": "^1.15.7",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.2.2",
		"ulid": "^3.0.2",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/node": "^25.6.0",
		"@types/sortablejs": "^1.15.9",
		"@vitejs/plugin-vue": "^5.2.1",
		"concurrently": "^9.2.1",
		"esbuild": "^0.28.0",
		"electron": "^41.2.1",
		"typescript": "^5.7.2",
		"vite": "^6.0.3",
		"vue": "^3.5.13",
		"vue-tsc": "^2.2.0",
		"wait-on": "^9.0.5"
	}
}
