{
	"name": "trackboi",
	"version": "1.0.0",
	"type": "module",
	"main": "src/electron/main.cjs",
	"description": "A local-first Kanban desktop app with an MCP server.",
	"scripts": {
		"dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && TRACKBOI_DEV_SERVER_URL=http://127.0.0.1:5173 env -u ELECTRON_RUN_AS_NODE electron .\"",
		"hmr": "vite --port 5173",
		"build": "vite build",
		"start": "env -u ELECTRON_RUN_AS_NODE electron ."
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.2.2",
		"@vueuse/core": "^14.2.1",
		"@vueuse/integrations": "^14.2.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-vue-next": "^1.0.0",
		"reka-ui": "^2.9.6",
		"sortablejs": "^1.15.7",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.2.2"
	},
	"devDependencies": {
		"@types/node": "^25.6.0",
		"@types/sortablejs": "^1.15.9",
		"@vitejs/plugin-vue": "^5.2.1",
		"concurrently": "^9.2.1",
		"electron": "^41.2.1",
		"typescript": "^5.7.2",
		"vite": "^6.0.3",
		"vue": "^3.5.13",
		"vue-tsc": "^2.2.0",
		"wait-on": "^9.0.5"
	}
}
