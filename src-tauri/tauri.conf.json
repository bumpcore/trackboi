{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Trackboi",
  "version": "0.1.0",
  "identifier": "dev.bumpcore.trackboi",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run hmr",
    "beforeBuildCommand": "bunx vite build"
  },
  "app": {
    "windows": [
      {
        "title": "Trackboi",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 480,
        "decorations": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
